{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "useUnknownInCatchVariables": true,
    "module": "None",
    "moduleResolution": "Node",
    "skipLibCheck": true
  },
  "files": [
    "src/shared/portal-security.ts",
    "src/shared/dto.ts",
    "src/shared/api-client.ts",
    "src/shared/professional-client.ts",
    "src/shared/dom.ts",
    "src/shared/blob-url-registry.ts",
    "src/portal/renderers.ts",
    "src/portal/application.ts",
    "src/professional/application.ts",
    "src/main.ts",
    "src/test-export.ts"
  ]
}
